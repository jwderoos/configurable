{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "threads": 10,
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "tests"
        ]
    },
    "mutators": {
        "@default": true,
        "ProtectedVisibility": {
            "ignore": [
                "jwderoos\\Configurable\\Trait\\ConfigurableServiceTrait::getConfigOptions"
            ]
        }
    }
}
