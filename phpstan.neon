includes:
    - phpstan-extension.neon
parameters:
    parallel:
        maximumNumberOfProcesses: 5
        jobSize: 5
        minimumNumberOfJobsPerProcess: 1
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false
    level: 9
    paths:
        - src
        - tests
    excludePaths:
        - tests/Service/InvalidCallback*Service.php
    ignoreErrors: []
